# Required
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional - Alpaca paper trading (free: https://app.alpaca.markets)
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here

# Trading mode: set to "true" to enable autonomous execution (default: signals only)
AUTO_EXECUTE=false

# Override default risk limits
MAX_POSITION_PCT=0.10
MAX_DAILY_LOSS_PCT=0.05
MAX_DRAWDOWN_PCT=0.15
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.15
MAX_OPEN_POSITIONS=10
INITIAL_CASH=100000
